# Copy to .env and fill in locally. .env is gitignored and must never be committed.
# Authentication uses a NAMED DATABRICKS CLI PROFILE, not tokens in this file.
#   databricks auth login --profile vm-summer-classic
DBX_PROFILE=
DBX_WAREHOUSE_ID=
DBX_ML_CLUSTER_ID=
DBX_CATALOG=
# Lakebase Postgres password is minted at runtime via the Databricks SDK
# (generate_database_credential); it is never stored here.
PGPASSWORD=
